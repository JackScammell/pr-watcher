root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Test inputs are byte-sensitive (fixture logs, tab-separated guard cases): never reformat them.
[watcher/test/**]
trim_trailing_whitespace = false
insert_final_newline = false

[*.tsv]
trim_trailing_whitespace = false
insert_final_newline = false
