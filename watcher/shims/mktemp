#!/bin/zsh -f
# mktemp shim (first on the watcher session's PATH; read-only like bin/). On this Mac /usr/bin/mktemp with no
# template (`mktemp`, `mktemp -d`, `mktemp [-d] -t prefix`) ignores $TMPDIR and uses /var/folders/…/T, which the
# sandbox refuses (docs/fix-sandbox-tests.md). Those forms get an explicit template under $TMPDIR; anything with a
# template, or an option we don't know, goes to /usr/bin/mktemp untouched.
setopt extendedglob
flags=() prefix=tmp i=1
while (( i <= $# )); do
  a=${@[i]}
  case $a in
    -[dqu]##) flags+=($a) ;;
    -[dqu]#t) f=${a%t}; [[ $f != - ]] && flags+=($f); (( i++ )); prefix=${@[i]:-tmp} ;;
    -[dqu]#t?*) f=${a%%t*}; [[ $f != - ]] && flags+=($f); prefix=${a#*t} ;;
    *) exec /usr/bin/mktemp "$@" ;;              # a template or an unknown option: not ours to change
  esac
  (( i++ ))
done
exec /usr/bin/mktemp $flags "${TMPDIR:-/tmp}/${prefix:t}.XXXXXXXX"
