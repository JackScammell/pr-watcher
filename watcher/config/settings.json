{
  "$comment": "Skills: prwatch-skillhook.sh (PreToolUse matcher Skill) is the authoritative layer, an allow-list that fails closed; the Skill deny rules and skillOverrides below are backstops. Deny beats allow: a call matching both a deny and an allow rule is denied, so Skill(code-review *) in allow never lets through the code-review forms in deny. Subagents: prwatch-agenthook.sh pre allows only general-purpose, and chaos:grumpy-<name> under the parliament engine. `review` is an alias of `code-review` (Claude Code 2.1.314): a skillOverride or deny rule on review also disables code-review, so review has neither; the hook refuses it by name.",
  "model": "opus[1m]",
  "askUserQuestionTimeout": "10m",
  "env": {
    "PRWATCH_HOME": "/Users/jack/prwatch",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_HOME": "/Users/jack/prwatch/cache/dotnet-home",
    "NUGET_PACKAGES": "/Users/jack/prwatch/cache/nuget",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "NUGET_HTTP_CACHE_PATH": "/Users/jack/prwatch/cache/nuget-http",
    "NUGET_PLUGINS_CACHE_PATH": "/Users/jack/prwatch/cache/nuget-plugins",
    "MSBUILDDISABLENODEREUSE": "1",
    "DOTNET_CLI_USE_MSBUILD_SERVER": "0",
    "npm_config_cache": "/Users/jack/prwatch/cache/npm",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "DOTNET_SYSTEM_NET_DISABLEIPV6": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(/Users/jack/prwatch/bin/prwatch-tick.sh *)",
      "Bash(/Users/jack/prwatch/bin/prwatch-prep.sh *)",
      "Bash(/Users/jack/prwatch/bin/prwatch-state.sh *)",
      "Bash(/Users/jack/prwatch/bin/prwatch-notify.sh *)",
      "Bash(/Users/jack/prwatch/bin/prwatch-cleanup.sh *)",
      "Read(//Users/jack/prwatch/**)",
      "Read(//Users/jack/Documents/vision-reviews/**)",
      "Write(//Users/jack/Documents/vision-reviews/**)",
      "Edit(//Users/jack/Documents/vision-reviews/**)",
      "CronCreate",
      "CronList",
      "CronDelete",
      "AskUserQuestion",
      "Skill(prwatch-start)",
      "Skill(prwatch-tick)",
      "Skill(prwatch-review *)",
      "Skill(prwatch-decide *)",
      "Skill(prwatch-eod)",
      "TaskStop",
      "Bash(/Users/jack/prwatch/bin/prwatch-ngtest.sh *)",
      "Bash(/Users/jack/prwatch/bin/prwatch-dotnettest.sh *)",
      "Skill(code-review *)"
    ],
    "ask": [
      "Bash(/Users/jack/prwatch/bin/prwatch-post.sh *)",
      "Bash(/Users/jack/prwatch/bin/prwatch-buildrun.sh *)",
      "Bash(*prwatch-post*)",
      "Bash(*prwatch-buildrun*)"
    ],
    "deny": [
      "Bash(gh *)",
      "Bash(/opt/homebrew/bin/gh *)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(security *)",
      "Bash(osascript *)",
      "Bash(sandbox-exec *)",
      "mcp__*",
      "WebFetch",
      "WebSearch",
      "RemoteTrigger",
      "ScheduleWakeup",
      "Agent(isolation:remote)",
      "Edit(//Users/jack/prwatch/bin/**)",
      "Write(//Users/jack/prwatch/bin/**)",
      "Edit(//Users/jack/prwatch/config/**)",
      "Write(//Users/jack/prwatch/config/**)",
      "Edit(//Users/jack/prwatch/.claude/**)",
      "Write(//Users/jack/prwatch/.claude/**)",
      "Edit(//Users/jack/prwatch/angles/**)",
      "Write(//Users/jack/prwatch/angles/**)",
      "Edit(//Users/jack/prwatch/CLAUDE.md)",
      "Write(//Users/jack/prwatch/CLAUDE.md)",
      "Edit(//Users/jack/prwatch/state/**)",
      "Write(//Users/jack/prwatch/state/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/Library/Keychains/**)",
      "Edit(//Users/jack/prwatch/repos/**)",
      "Write(//Users/jack/prwatch/repos/**)",
      "Edit(~/.zshrc)",
      "Write(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Write(~/.zprofile)",
      "Edit(~/.gitconfig)",
      "Write(~/.gitconfig)",
      "Edit(~/Library/LaunchAgents/**)",
      "Write(~/Library/LaunchAgents/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Skill(security-review)",
      "Skill(security-review *)",
      "Skill(schedule)",
      "Skill(schedule *)",
      "Skill(loop)",
      "Skill(loop *)",
      "Read(~/.composer/**)",
      "Read(~/Documents/GitHub/**)",
      "Edit(//Users/jack/prwatch/shims/**)",
      "Write(//Users/jack/prwatch/shims/**)",
      "Skill(chaos:*)",
      "Skill(chaos:parliament-review)",
      "Skill(chaos:parliament-review *)",
      "Skill(chaos:summon-council)",
      "Skill(chaos:summon-council *)",
      "Skill(chaos:implement-task-list)",
      "Skill(chaos:implement-task-list *)",
      "Skill(chaos:parliament-loop)",
      "Skill(chaos:parliament-loop *)",
      "Skill(chaos:parliament-monitor)",
      "Skill(chaos:parliament-monitor *)",
      "Skill(chaos:parliament-webhook)",
      "Skill(chaos:parliament-webhook *)",
      "Skill(chaos:commit-and-push)",
      "Skill(chaos:commit-and-push *)",
      "Skill(chaos:ci-watch)",
      "Skill(chaos:ci-watch *)",
      "Skill(chaos:cut-release)",
      "Skill(chaos:cut-release *)",
      "Skill(chaos:fast-track)",
      "Skill(chaos:fast-track *)",
      "Skill(chaos:debate-topic)",
