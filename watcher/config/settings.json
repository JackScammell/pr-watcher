      "Skill(chaos:plugin-install)",
      "Skill(chaos:plugin-install *)",
      "Skill(chaos:plugin-upgrade)",
      "Skill(chaos:plugin-upgrade *)",
      "Skill(chaos:update-dependencies)",
      "Skill(chaos:update-dependencies *)",
      "Skill(code-review ultra*)",
      "Skill(code-review max*)",
      "Skill(code-review xhigh*)",
      "Skill(code-review *--comment*)",
      "Skill(code-review *--fix*)",
      "Skill(code-review *--post*)",
      "Skill(code-review *--max-findings*)",
      "Bash(claude *)",
      "Bash(* claude plugin *)",
      "Bash(chflags *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "/Users/jack/prwatch/bin/prwatch-tick.sh *",
      "/Users/jack/prwatch/bin/prwatch-prep.sh *",
      "/Users/jack/prwatch/bin/prwatch-state.sh *",
      "/Users/jack/prwatch/bin/prwatch-notify.sh *",
      "/Users/jack/prwatch/bin/prwatch-cleanup.sh *",
      "/Users/jack/prwatch/bin/prwatch-post.sh *",
      "/Users/jack/prwatch/bin/prwatch-buildrun.sh *",
      "/Users/jack/prwatch/bin/prwatch-ngtest.sh *",
      "/Users/jack/prwatch/bin/prwatch-dotnettest.sh *"
    ],
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyWrite": [
        "/Users/jack/prwatch/bin",
        "/Users/jack/prwatch/config",
        "/Users/jack/prwatch/.claude",
        "/Users/jack/prwatch/angles",
        "/Users/jack/prwatch/CLAUDE.md",
        "/Users/jack/prwatch/state",
        "/Users/jack/prwatch/repos",
        "/Users/jack/prwatch/shims",
        "/Users/jack/.claude",
        "/opt/homebrew"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/Library/Keychains",
          "mode": "deny"
        },
        {
          "path": "~/.composer",
          "mode": "deny"
        },
        {
          "path": "~/Documents/GitHub",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-guard.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-agenthook.sh pre"
          }
        ]
      },
      {
        "matcher": ".*(Cron|Schedule|Wakeup|Trigger).*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-prompthook.sh sched"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-skillhook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-agenthook.sh post"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/touch /Users/jack/prwatch/state/activity"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/touch /Users/jack/prwatch/state/activity"
          },
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-prompthook.sh prompt"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-notify.sh stuck permission"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/touch /Users/jack/prwatch/state/activity"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jack/prwatch/bin/prwatch-agenthook.sh ended"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "security-review": "off",
    "schedule": "off",
    "loop": "off",
    "chaos:parliament-review": "user-invocable-only",
    "chaos:summon-council": "user-invocable-only",
    "chaos:implement-task-list": "user-invocable-only",
    "chaos:parliament-loop": "user-invocable-only",
    "chaos:parliament-monitor": "user-invocable-only",
    "chaos:debate-topic": "user-invocable-only",
    "chaos:ask-council": "user-invocable-only",
    "chaos:fast-track": "user-invocable-only"
  }
}
